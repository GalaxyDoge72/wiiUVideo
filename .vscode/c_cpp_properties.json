{
    "configurations": [

        {
            "name": "Wii U Homebrew (devkitPPC/wut)",
            "includePath": [
                "${workspaceFolder}/**",
                "C:/devkitpro/wut/include",
                "C:/devkitpro/devkitPPC/include",
                "C:/devkitpro/portlibs/ppc/include/**"
            ],
            "defines": [
                "GEKKO",
                "HW_WIIU",
                "__WIIU__"
            ],
            "compilerPath": "C:/devkitpro/devkitPPC/bin/powerpc-eabi-gcc.exe", // Or .exe for Windows
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "windows-gcc-arm" // Or "windows-gcc-arm" for Windows host
        }
    ],
    "version": 4
}